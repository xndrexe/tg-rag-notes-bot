# Токен Telegram-бота, получить у @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Где хранить данные (документы и векторное хранилище)
DATA_DIR=./data
STORE_DIR=./data/vectors
STORAGE_DIR=./data/docs

# Параметры RAG
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=4
MAX_FILE_MB=20

# Опционально: OpenAI для генеративного ответа. Без них бот работает
# в extractive-режиме — возвращает релевантные цитаты.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

LOG_LEVEL=INFO
